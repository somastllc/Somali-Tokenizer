from os import PathLike

__version__: str
HUB_REPO_V2: str

class ContractError(ValueError):
    """The artifact does not satisfy the somali-bpe v2 contract."""

class Encoding:
    @property
    def ids(self) -> list[int]: ...
    @property
    def tokens(self) -> list[str]: ...
    @property
    def offsets(self) -> list[tuple[int, int]]: ...
    def __len__(self) -> int: ...

class SomaliTokenizer:
    @staticmethod
    def v2() -> SomaliTokenizer: ...
    @staticmethod
    def from_file(path: str | PathLike[str]) -> SomaliTokenizer: ...
    @staticmethod
    def from_str(json: str) -> SomaliTokenizer: ...
    @staticmethod
    def from_pretrained(
        repo_id: str = "somast/somali-tokenizer", revision: str | None = None
    ) -> SomaliTokenizer: ...
    def encode(self, text: str) -> Encoding: ...
    def encode_batch(self, texts: list[str]) -> list[Encoding]: ...
    def decode(self, ids: list[int], skip_special_tokens: bool = False) -> str: ...
    def decode_batch(
        self, sequences: list[list[int]], skip_special_tokens: bool = False
    ) -> list[str]: ...
    @property
    def vocab_size(self) -> int: ...
    @property
    def special_tokens(self) -> list[str]: ...
    def token_to_id(self, token: str) -> int | None: ...
    def id_to_token(self, id: int) -> str | None: ...
    def to_str(self, pretty: bool = False) -> str: ...
    def __len__(self) -> int: ...
